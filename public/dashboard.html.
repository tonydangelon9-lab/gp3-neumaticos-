<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="GP3 Live">
  <meta name="theme-color" content="#000000">
  <title>GP3 Live</title>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html,body{height:100%;background:#0a0a0f;}
    body{font-family:'Barlow',sans-serif;color:#fff;-webkit-font-smoothing:antialiased;}
    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@400;500;600;700&display=swap');
    ::-webkit-scrollbar{width:4px;height:4px;}
    ::-webkit-scrollbar-track{background:#111;}
    ::-webkit-scrollbar-thumb{background:#333;border-radius:2px;}
    @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
    @keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    .container{max-width:1200px;margin:0 auto;padding:16px;}
    header{background:#111118;border-bottom:1px solid #2a2a3a;padding:10px 16px;position:sticky;top:0;z-index:100;}
    header .content{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
    .logo{display:flex;align-items:center;gap:8px;}
    .logo-gp{display:flex;align-items:stretch;}
    .logo-gp-white{background:#fff;border-radius:6px 0 0 6px;padding:3px 8px;display:flex;align-items:center;}
    .logo-gp-white span{font-family:'Barlow Condensed',sans-serif;font-size:20px;font-weight:900;color:#0a0a0f;letter-spacing:-1;line-height:1;}
    .logo-gp-red{background:#E8001D;border-radius:0 6px 6px 0;padding:0 8px;display:flex;align-items:center;transform:skewX(-6deg);margin-left:-2px;}
    .logo-gp-red span{font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:900;color:#fff;letter-spacing:-2;line-height:1;display:inline-block;transform:skewX(6deg);}
    .logo-text{display:flex;flex-direction:column;gap:1px;}
    .logo-text-main{font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:700;color:#fff;letter-spacing:3;text-transform:uppercase;line-height:1;}
    .logo-text-sub{font-family:'Barlow Condensed',sans-serif;font-size:8px;font-weight:600;color:#E8001D;letter-spacing:2;text-transform:uppercase;line-height:1;}
    .header-info{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
    .badge{display:inline-flex;align-items:center;padding:3px 8px;border-radius:3px;background:#E8001D22;border:1px solid #E8001D44;color:#E8001D;font-size:10px;font-weight:700;letter-spacing:1;text-transform:uppercase;font-family:'Barlow Condensed',sans-serif;white-space:nowrap;}
    .date-info{font-size:11px;color:#555570;font-family:'Barlow Condensed',sans-serif;letter-spacing:1;}
    main{padding:16px;}
    .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-bottom:24px;}
    .kpi-box{background:#1a1a24;border:1px solid #2a2a3a;border-radius:10px;padding:14px;border-top:2px solid #E8001D;}
    .kpi-value{font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:900;color:#E8001D;line-height:1;letter-spacing:-1;}
    .kpi-label{font-size:10px;color:#8888aa;text-transform:uppercase;letter-spacing:1;margin-top:4px;font-family:'Barlow Condensed',sans-serif;}
    .section-title{font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:3;text-transform:uppercase;color:#fff;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #2a2a3a;}
    .results-table{background:#1a1a24;border:1px solid #2a2a3a;border-radius:10px;overflow:hidden;}
    .results-header{display:grid;grid-template-columns:1fr 80px 80px 80px;padding:12px 14px;background:#111118;border-bottom:1px solid #2a2a3a;font-size:9px;color:#8888aa;text-transform:uppercase;letter-spacing:1;font-weight:700;}
    .results-row{display:grid;grid-template-columns:1fr 80px 80px 80px;padding:12px 14px;border-bottom:1px solid #2a2a3a;align-items:center;}
    .results-row:last-child{border-bottom:none;}
    .results-row-name{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:14px;color:#fff;}
    .results-row-cat{font-size:10px;color:#8888aa;margin-top:2px;}
    .results-value{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:16px;text-align:right;}
    .usd{color:#00d4aa;}
    .ars{color:#ffd700;}
    .units{color:#E8001D;}
    .no-data{text-align:center;padding:24px;color:#8888aa;}
    footer{text-align:center;padding:12px 16px;font-size:9px;color:#555570;border-top:1px solid #2a2a3a;letter-spacing:1;text-transform:uppercase;font-family:'Barlow Condensed',sans-serif;}
    @media(max-width:640px){.kpi-grid{grid-template-columns:repeat(2,1fr);}header .content{flex-direction:column;align-items:flex-start;}.results-header,.results-row{grid-template-columns:1fr 60px 60px 60px;font-size:10px;}}
  </style>
</head>
<body>
  <header>
    <div class="content">
      <div class="logo">
        <div class="logo-gp">
          <div class="logo-gp-white"><span>GP</span></div>
          <div class="logo-gp-red"><span> 3</span></div>
        </div>
        <div class="logo-text">
          <div class="logo-text-main">SPORTS LATAM</div>
          <div class="logo-text-sub">NEUMÁTICOS PIRELLI</div>
        </div>
      </div>
      <div class="header-info">
        <span class="badge">EN VIVO</span>
        <span class="date-info" id="currentDate">Cargando...</span>
      </div>
    </div>
  </header>

  <main class="container">
    <div class="kpi-grid">
      <div class="kpi-box">
        <div class="kpi-value" id="clientCount">0</div>
        <div class="kpi-label">Clientes Atendidos</div>
      </div>
      <div class="kpi-box">
        <div class="kpi-value" id="unitCount">0</div>
        <div class="kpi-label">Neumáticos Vendidos</div>
      </div>
      <div class="kpi-box" style="border-top-color:#00d4aa;">
        <div class="kpi-value usd" id="totalUSD">0</div>
        <div class="kpi-label">Total USD</div>
      </div>
      <div class="kpi-box" style="border-top-color:#ffd700;">
        <div class="kpi-value ars" id="totalARS">0</div>
        <div class="kpi-label">Total ARS</div>
      </div>
    </div>

    <div class="section-title">Últimas Ventas en Vivo</div>
    <div class="results-table">
      <div class="results-header">
        <span>Piloto</span>
        <span>Categoría</span>
        <span>Unidades</span>
        <span>Total</span>
      </div>
      <div id="resultsBody">
        <div class="no-data">Sin ventas registradas</div>
      </div>
    </div>
  </main>

  <footer>
    GP3 Sports LATAM · CAV 2026 · Pirelli Official Partner
  </footer>

  <script>
    const SHEETS_URL = "https://script.google.com/macros/s/AKfycbxh0cN7SV9tZtR0bgvZH6ysGzxQgApFiKn7O4C9mN7HUV8h3hWpLbq2fqYbw5XV1Jk3/exec";

    function fmt(val, moneda) {
      const n = Number(val).toLocaleString("es-AR");
      return moneda === "ARS" ? "$ " + n : "USD " + n;
    }

    function updateDate() {
      const today = new Date().toISOString().slice(0, 10);
      document.getElementById('currentDate').textContent = today;
    }

    async function loadData() {
      try {
        const response = await fetch(SHEETS_URL);
        const data = await response.json();
        if (!data.ventas) return;

        const ventas = data.ventas;
        const totalClientes = ventas.length;
        const totalUnidades = ventas.reduce((s, v) => s + (v.total_unidades || 0), 0);
        const totalUSD = ventas.filter(v => v.moneda === "USD").reduce((s, v) => s + v.total_monto, 0);
        const totalARS = ventas.filter(v => v.moneda === "ARS").reduce((s, v) => s + v.total_monto, 0);

        document.getElementById('clientCount').textContent = totalClientes;
        document.getElementById('unitCount').textContent = totalUnidades;
        document.getElementById('totalUSD').textContent = fmt(totalUSD, "USD");
        document.getElementById('totalARS').textContent = fmt(totalARS, "ARS");

        const resultsBody = document.getElementById('resultsBody');
        if (ventas.length === 0) {
          resultsBody.innerHTML = '<div class="no-data">Sin ventas registradas</div>';
          return;
        }

        resultsBody.innerHTML = ventas.map(v => `
          <div class="results-row">
            <div>
              <div class="results-row-name">#${v.num_piloto || "—"} ${v.piloto}</div>
              <div class="results-row-cat">${v.categoria}</div>
            </div>
            <div class="results-value units">${v.total_unidades}</div>
            <div class="results-value" style="color:${v.moneda === 'USD' ? '#00d4aa' : '#ffd700'}">${v.moneda}</div>
            <div class="results-value" style="color:#E8001D">${fmt(v.total_monto, v.moneda)}</div>
          </div>
        `).join('');
      } catch (error) {
        console.error('Error:', error);
      }
    }

    updateDate();
    loadData();
    setInterval(loadData, 5000);
  </script>
</body>
</html>
